{
  "name": "civicnode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "verifier": "node scripts/verifier.mjs",
    "test": "node scripts/verifier.mjs && node --test tests/*.test.mjs",
    "prebuild": "node scripts/verifier.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "station": "node scripts/verifier.mjs && CIVZERO_STATION=1 astro build && pagefind --site dist && node assistant/station.mjs",
    "mesurer": "node assistant/mesurer.mjs",
    "adapter": "node agent/adapter.mjs",
    "integrer": "node agent/integrer.mjs",
    "medias": "node agent/medias.mjs",
    "sources": "node agent/sources.mjs",
    "relire": "node agent/relire.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "pagefind": "^1.1.0",
    "playwright": "^1.65.0"
  }
}
