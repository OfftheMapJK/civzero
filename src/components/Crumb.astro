---
// Fil d'Ariane : socle / savoir, et retour à l'accueil.
import { HOME } from '../lib/model.mjs';
interface Props { c: { a: string; aHref?: string; b?: string; bHref?: string }; t: any }
const { c, t } = Astro.props;
---
<div class="crumb">
  <span>/ {c.aHref ? <a href={c.aHref}>{c.a}</a> : c.a}{c.b && <> / <strong>{c.bHref ? <a href={c.bHref}>{c.b}</a> : c.b}</strong></>}</span>
  <a href={HOME}>{t.accueil}</a>
</div>
