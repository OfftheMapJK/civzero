---
import Base from '../../layouts/Base.astro';
import Forme from '../Forme.astro';
import { HOME } from '../../lib/model.mjs';
const { p } = Astro.props;
const t = p.t;
---
<Base title={p.title} p={p}>
  <div class="crumb"><span>/ <strong>{t.toutes.toUpperCase()}</strong></span><a href={HOME}>{t.accueil}</a></div>
  <h1>{t.toutesTitre(p.total, p.actives)}</h1>
  <p class="lead">{t.toutesLead}</p>
  {p.groupes.map((g: any) => (
    <>
      <h2>{g.titre}</h2>
      <div class="tablebox">
        <table>
          <thead><tr><th>{t.col.num}</th><th>{t.col.fiche}</th><th>{t.col.temps}</th><th>{t.col.danger}</th><th>{t.col.tier}</th><th>{t.col.exige}</th></tr></thead>
          <tbody>
            {g.lignes.map((l: any) => (
              <tr>
                <td>{l.num}</td>
                {l.href
                  ? <td><a href={l.href}>{l.titre}</a>{l.suspendu && t.enSuspens}</td>
                  : <td class="avenir-txt">{l.titre} · {l.prevue ? t.prevue : t.aVenirMin}</td>}
                <td>{l.temps}</td>
                <td><Forme niveau={l.niveau} taille="1rem" t={t} /> {l.niveauMot}</td>
                <td>{l.tier}</td>
                <td>{l.exige}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
</Base>
