---
// Rapport de reproduction : texte à copier, envoi par GitHub ou par e-mail.
import Base from '../../layouts/Base.astro';
import Crumb from '../Crumb.astro';
import { HOME } from '../../lib/model.mjs';
const { p } = Astro.props;
const t = p.t;
---
<Base title={p.title} p={p}>
  <Crumb c={p.crumb} t={t} />
  <h1>{t.rapportTitre}</h1>
  <p class="lead">{t.rapportLead(p.titre)}</p>
  <label class="lab" for="rapport">{t.rapportCopier}</label>
  <textarea id="rapport" spellcheck="false">{p.modele}</textarea>
  <div class="panel">
    <span class="lab">{t.rapportOu}</span>
    {p.github ? (
      <>
        <a class="btn plein" href={p.github}>{t.rapportGithub}</a>
        <p class="src">{t.rapportGithubNote}</p>
      </>
    ) : <p>{t.rapportSansDepot}</p>}
    {p.email
      ? <p>{t.rapportEmail} <strong style="user-select:all">{p.email}</strong></p>
      : <p>{t.rapportSansEmail}</p>}
    <p class="src">{t.rapportHorsLigne}</p>
  </div>
  <div class="row">
    <a class="btn" href={p.fiche}>{t.retourFiche}</a>
    <a class="btn" href={HOME}>{t.accueilBtn}</a>
  </div>
</Base>
