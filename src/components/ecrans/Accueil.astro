---
// Accueil : la baseline, la recherche, « Commencer ici », puis les familles et leurs socles.
import Base from '../../layouts/Base.astro';
import OptFiche from '../OptFiche.astro';
import Forme from '../Forme.astro';
import { STATION } from '../../lib/model.mjs';
const { p } = Astro.props;
const t = p.t;
---
<Base title={p.title} p={p}>
  <h1>&gt; {t.baseline}</h1>
  <p class="lead">{t.interstice}</p>
  <p class="lead">{t.expl}</p>

  <form class="cherche" action="recherche.html" method="get">
    <label class="lab" for="q">{t.chercherLab}</label>
    <div>
      <input id="q" name="q" type="search" placeholder={t.chercherPh} />
      <button class="btn plein" type="submit">{t.chercherBtn}</button>
    </div>
  </form>
  {STATION && <a class="btn" href="assistant">{t.assistantBtn}</a>}

  <h2>{t.commencer}</h2>
  <div class="choix">{p.commencer.map((o: any) => <OptFiche o={o} t={t} />)}</div>

  {p.familles.map((fa: any) => (
    <>
      <h2>{fa.nom}</h2>
      <div class="tuiles">
        {fa.socles.map((s: any) => (
          <a class:list={['tuile', { vide: !s.ouvert }]} href={s.href}>
            <span class="n">{s.compte}</span>
            <span><span class="t">{s.nom}</span><span class="s">{s.domaine}</span></span>
          </a>
        ))}
      </div>
    </>
  ))}

  <div class="legende">
    <strong>{t.legende}</strong>
    {['vert', 'orange', 'rouge'].map((n) => <span><Forme niveau={n} taille="1.25rem" t={t} /><strong>{t.niv[n]}</strong></span>)}
  </div>
  <div class="row"><a class="btn" href="toutes.html">{t.toutesBtn}</a></div>
</Base>
