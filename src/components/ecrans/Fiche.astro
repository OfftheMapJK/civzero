---
// Présentation d'une fiche : danger, exigences, principe, étapes, provenance.
import Base from '../../layouts/Base.astro';
import Crumb from '../Crumb.astro';
import Badges from '../Badges.astro';
import Ecouter from '../Ecouter.astro';
import Danger from '../Danger.astro';
import Forme from '../Forme.astro';
import Provenance from '../Provenance.astro';
const { p } = Astro.props;
const t = p.t;
---
<Base title={p.title} p={p}>
  <Crumb c={p.crumb} t={t} />
  <h1>{p.titre}</h1>
  <Badges badges={p.badges} />
  <Ecouter phrases={p.lecture} lang={p.lang} t={t} />
  {p.nonTraduite && <div class="panel">{p.nonTraduite}</div>}
  {p.suspension && <div class="panel"><span class="lab">{t.suspens}</span>{p.suspension}</div>}
  <Danger danger={p.danger} t={t} />
  {p.securiteHtml && <div class="prose" set:html={p.securiteHtml} />}

  <div class="panel">
    <span class="lab">{t.exige}</span>{p.exige}
    {p.variantes.length > 0 && (
      <>
        <span class="lab">{t.variantes}</span>
        <span>{p.variantes.map((v: any, i: number) => <>{i > 0 && ' · '}<Forme niveau={v.niveau} taille="1rem" t={t} /> {v.nom}</>)}</span>
      </>
    )}
  </div>

  <div class="prose"><h2>{t.principe}</h2><Fragment set:html={p.principeHtml} /></div>
  {p.prefaceHtml && <div class="prose" set:html={p.prefaceHtml} />}

  {p.premiere && (
    <>
      <a class="btn plein" href={p.premiere}>{t.commencerPas(p.etapes.length)}</a>
      <div>
        <h2>{t.etapes}</h2>
        <ol class="etapes">{p.etapes.map((e: any) => <li><a href={e.href}>{e.titre}</a></li>)}</ol>
      </div>
    </>
  )}

  {p.coince.length > 0 && (
    <div class="prose">
      <h2>{t.coince}</h2>
      <ul>{p.coince.map((c: any) => <li><strong set:html={c.probleme} /> <span set:html={c.texte} /></li>)}</ul>
    </div>
  )}

  <Provenance p={p} />

  <div class="row">
    <a class="btn" href={p.complete}>{t.completeBtn}</a>
    <a class="btn" href={p.rapport}>{t.rapportBtn}</a>
  </div>
</Base>
