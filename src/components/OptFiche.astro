---
// Une fiche dans une liste : active (lien) ou à venir (grisée, en pointillés).
import Forme from './Forme.astro';
interface Props { o: { href: string | null; titre: string; niveau: string; sub: string; note: string } }
const { o } = Astro.props;
---
{o.href ? (
  <a class="opt" href={o.href}>
    <Forme niveau={o.niveau} taille="1.75rem" />
    <span>
      <span class="t">{o.titre}</span>
      <span class="s">{o.sub}</span>
      {o.note && <span class="note">{o.note}</span>}
    </span>
    <span class="go" aria-hidden="true">&gt;</span>
  </a>
) : (
  <div class="opt vide">
    <span>
      <span class="t">{o.titre}</span>
      <span class="s">{o.sub}</span>
    </span>
    <span class="go">À VENIR</span>
  </div>
)}
