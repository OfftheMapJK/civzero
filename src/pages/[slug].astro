---
// Pages en anglais (langue principale), à la racine du site.
import { loadCorpus } from '../lib/corpus.mjs';
import { buildModel } from '../lib/model.mjs';
import Ecran from '../components/Ecran.astro';

export function getStaticPaths() {
  const { pages } = buildModel(loadCorpus(undefined, 'en'));
  return pages.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<Ecran p={p} />
